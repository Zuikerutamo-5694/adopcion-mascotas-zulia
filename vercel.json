{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm --prefix frontend install --include=dev",
  "buildCommand": "npm --prefix frontend run build:web",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/src/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|_expo/|assets/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
