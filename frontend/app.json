{
  "expo": {
    "name": "Red de Adopción Zulia",
    "slug": "adopcion-mascotas-web",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "adopcion-mascotas",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F4EE"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Red Comunitaria de Adopción y Rescate Zulia",
      "shortName": "Adopción Zulia",
      "lang": "es",
      "themeColor": "#134E3A",
      "backgroundColor": "#F6F4EE"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
